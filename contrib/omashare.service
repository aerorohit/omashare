[Unit]
Description=Omashare node (Iroh LAN + relay)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
# Install the binary to ~/.local/bin or change this path.
# The unit runs the node (no TTY). Offers need the TUI, the plugin, or `omashare accept`.
ExecStart=%h/.local/bin/omashare
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
